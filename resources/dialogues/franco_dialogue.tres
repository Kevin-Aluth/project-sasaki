[sub_resource type="Resource" id="Resource_k2kit"]
script = ExtResource("1_lymu3")
speaker = 1
text = "Capibara?!"

[sub_resource type="Resource" id="Resource_ijceq"]
script = ExtResource("2_6tcx1")
text = "Scusa, me ne vado"
next = &"sorry"

[sub_resource type="Resource" id="Resource_p02an"]
script = ExtResource("2_6tcx1")
text = "Vuoi problemi?"
next = &"problems"

[sub_resource type="Resource" id="Resource_xuwr8"]
script = ExtResource("2_6tcx1")
text = "Ho bisogno di aiuto per sconfiggere il samurai"
next = &"spared"

[sub_resource type="Resource" id="Resource_j86su"]
script = ExtResource("1_lymu3")
text = "Oh! Ma come ti permetti, io sono Franco. Cazzo vuoi?"
responses = Array[ExtResource("2_6tcx1")]([SubResource("Resource_ijceq"), SubResource("Resource_p02an"), SubResource("Resource_xuwr8")])

[sub_resource type="Resource" id="Resource_7ogtn"]
script = ExtResource("1_lymu3")
id = &"sorry"
text = "Non ti scuso, cogliona. Vattene!"
next = &"end"

[sub_resource type="Resource" id="Resource_xsqm4"]
